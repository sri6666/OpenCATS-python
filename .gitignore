.project
.settings/*
docker/data/*
docker/persist/*
vendor/*
attachments/*
temp/*
uploads/*
# Ignore Mac DS_Store files
.DS_Store
/vendor/
*.diff
*.rej

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual environments
venv/
ENV/
env/
.venv

# Flask
instance/
.webassets-cache

# Environment variables
.env
.env.local
.flaskenv

# SQLite databases
*.db
*.sqlite
*.sqlite3

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Logs
*.log
