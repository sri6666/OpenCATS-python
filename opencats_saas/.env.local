# Local Development Environment
# Copy this to .env for local testing

# Flask
FLASK_ENV=development
SECRET_KEY=local-dev-secret-key-change-in-production
FLASK_DEBUG=1

# Database (using Docker MySQL)
DATABASE_URL=mysql+pymysql://opencats:opencats123@localhost:3306/opencats_dev

# Redis (using Docker Redis)
REDIS_URL=redis://localhost:6379/0

# Email (local testing - use MailHog or similar)
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USE_TLS=false
MAIL_DEFAULT_SENDER=noreply@localhost

# File Storage (local)
USE_S3=false
UPLOAD_FOLDER=./uploads

# Stripe (test mode - get keys from stripe.com/test)
STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://localhost:9200

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Sentry (optional - for error tracking)
# SENTRY_DSN=

# AWS S3 (optional - for production file storage)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET=opencats-uploads
# AWS_S3_REGION=us-east-1
